# OEM cloud OAuth (public client IDs — safe in Vite)
# Leave unset to use SpryMD sandbox OAuth consent (full flow still works).
# VITE_FITBIT_CLIENT_ID=
# VITE_OURA_CLIENT_ID=
# VITE_WHOOP_CLIENT_ID=
# VITE_WITHINGS_CLIENT_ID=
# VITE_GARMIN_CLIENT_ID=
# VITE_DEXCOM_CLIENT_ID=
# VITE_GOOGLE_FIT_CLIENT_ID=
# VITE_POLAR_CLIENT_ID=
# VITE_COROS_CLIENT_ID=
# VITE_ZEPP_CLIENT_ID=
# VITE_ULTRAHUMAN_CLIENT_ID=
# VITE_CIRCULAR_CLIENT_ID=
# VITE_RESMED_CLIENT_ID=
# VITE_PHILIPS_CLIENT_ID=
# VITE_EIGHT_SLEEP_CLIENT_ID=
# VITE_SLEEP_NUMBER_CLIENT_ID=
# VITE_LIBRE_CLIENT_ID=
# VITE_LEVELS_CLIENT_ID=
# VITE_OMRON_CLIENT_ID=
# VITE_MASIMO_CLIENT_ID=
# VITE_GENERIC_OEM_CLIENT_ID=

# Optional: extra owner emails (comma-separated). Built-ins remain.
# Email allowlist only — never put passwords here.
# VITE_MASTER_EMAIL=
# Optional: extra clinical staff emails (comma-separated).
# VITE_STAFF_EMAIL=

# Server-only secrets for /api/oauth/token live exchange (never VITE_*)
# FITBIT_CLIENT_SECRET=
# OURA_CLIENT_SECRET=
# WHOOP_CLIENT_SECRET=
# WITHINGS_CLIENT_SECRET=
# GARMIN_CLIENT_SECRET=
# DEXCOM_CLIENT_SECRET=
# GOOGLE_FIT_CLIENT_SECRET=
# POLAR_CLIENT_SECRET=

# Akute Health EHR (server-only — never VITE_* for the API key)
# AKUTE_API_KEY=
# AKUTE_WEBHOOK_SECRET=
# AKUTE_BASE_URL=https://api.akutehealth.com/v1
# AKUTE_PROVIDER_ID=
# Optional public chart deep-link base (safe for Vite)
# VITE_AKUTE_APP_BASE_URL=https://app.akutehealth.com
# AKUTE_APP_BASE_URL=https://app.akutehealth.com
