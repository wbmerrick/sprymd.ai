# SpryMD launch keys
# Put server secrets in the host (Vercel), not in VITE_* and not in git.
# The browser Supabase URL and publishable key are already in local .env.
#
# Cash-pay checkout (required)
# STRIPE_SECRET_KEY=                 # Stripe secret key. No publishable key is used.
# STRIPE_WEBHOOK_SECRET=            # Signing secret for POST /api/webhooks/stripe
# SUPABASE_SERVICE_ROLE_KEY=        # Server only. Bypasses RLS for paid-visit updates.
# SUPABASE_URL=                     # Optional if VITE_SUPABASE_URL is already set.
#
# Live video — set Daily OR Twilio, not both, unless VIDEO_VENDOR picks one
# DAILY_API_KEY=                    # Preferred. Sign Daily's BAA before patient visits.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# VIDEO_VENDOR=                     # Optional: daily | twilio | off
#
# Receipts (optional)
# RESEND_API_KEY=                   # Without this, payment email is only logged.
# CHECKOUT_FROM_EMAIL=              # Default: SpryMD <noreply@sprymd.ai>
# APP_URL=                          # Optional public origin for Checkout return URLs.
#
# OEM cloud OAuth (public client IDs — safe in Vite)
# Leave unset to use SpryMD sandbox OAuth consent (full flow still works).
# VITE_FITBIT_CLIENT_ID=
# VITE_OURA_CLIENT_ID=
# VITE_WHOOP_CLIENT_ID=
# VITE_WITHINGS_CLIENT_ID=
# VITE_GARMIN_CLIENT_ID=
# VITE_DEXCOM_CLIENT_ID=
# VITE_GOOGLE_FIT_CLIENT_ID=
# VITE_POLAR_CLIENT_ID=
# VITE_COROS_CLIENT_ID=
# VITE_ZEPP_CLIENT_ID=
# VITE_ULTRAHUMAN_CLIENT_ID=
# VITE_CIRCULAR_CLIENT_ID=
# VITE_RESMED_CLIENT_ID=
# VITE_PHILIPS_CLIENT_ID=
# VITE_EIGHT_SLEEP_CLIENT_ID=
# VITE_SLEEP_NUMBER_CLIENT_ID=
# VITE_LIBRE_CLIENT_ID=
# VITE_LEVELS_CLIENT_ID=
# VITE_OMRON_CLIENT_ID=
# VITE_MASIMO_CLIENT_ID=
# VITE_GENERIC_OEM_CLIENT_ID=

# Optional: extra master/owner emails (comma-separated). Built-in owner email remains.
# Email allowlist only — never put passwords here.
# VITE_MASTER_EMAIL=

# Server-only: extra ops/clinician emails (comma-separated). Built-in owner remains.
# Used by /api/ops/* — allowlisted staff auto-get a providers row on first API call.
# OPS_STAFF_EMAILS=
# MASTER_EMAILS=

# Server-only secrets for /api/oauth/token live exchange (never VITE_*)
# FITBIT_CLIENT_SECRET=
# OURA_CLIENT_SECRET=
# WHOOP_CLIENT_SECRET=
# WITHINGS_CLIENT_SECRET=
# GARMIN_CLIENT_SECRET=
# DEXCOM_CLIENT_SECRET=
# GOOGLE_FIT_CLIENT_SECRET=
# POLAR_CLIENT_SECRET=
