# =============================================================================
# SpryMD environment variables
#
# Copy this file to .env and fill in the values. Only VITE_-prefixed variables
# are exposed to the browser bundle — never put secrets in a VITE_ variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (client)
# -----------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# -----------------------------------------------------------------------------
# Stripe (client)
# Get keys from https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=
# Per-service Payment Links (Quiz fallback when publishable key not set)
VITE_STRIPE_PAYMENT_LINK_ED=https://buy.stripe.com/your-ed-link
VITE_STRIPE_PAYMENT_LINK_WEIGHT=https://buy.stripe.com/your-weight-link
# Discreet billing descriptor — no clinical terms
VITE_PAYMENT_STATEMENT_DESCRIPTOR=SPRYMD

# -----------------------------------------------------------------------------
# Company / legal (shown in footer, Terms, Privacy, NPP)
# -----------------------------------------------------------------------------
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ADDRESS_LINE1=
VITE_COMPANY_ADDRESS_LINE2=
VITE_COMPANY_PHONE=
VITE_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Analytics (loaded only after cookie consent)
# -----------------------------------------------------------------------------
VITE_GTM_ID=
VITE_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Provider portal
# -----------------------------------------------------------------------------
VITE_PROVIDER_ACCESS_CODE=

# -----------------------------------------------------------------------------
# Feature flags (default off; only the exact string "true" enables)
# See src/lib/flags.ts
# -----------------------------------------------------------------------------
VITE_FEATURE_WEIGHT_LOSS=false
VITE_FEATURE_MESSAGING=false
VITE_FEATURE_REFILLS=false

# -----------------------------------------------------------------------------
# Crypto payments — not yet implemented — feature flagged off
# -----------------------------------------------------------------------------
# Enable Stripe stablecoin/crypto in Dashboard → Payment methods, then set:
VITE_STRIPE_CRYPTO_ENABLED=false
# Set to true once a provider is configured below
VITE_CRYPTO_PAYMENTS_ENABLED=false
# stripe | coinbase | bitpay | opennode
VITE_CRYPTO_PROVIDER=stripe
# Third-party crypto processors (if not using Stripe stablecoin)
VITE_COINBASE_COMMERCE_API_KEY=
VITE_BITPAY_TOKEN=
VITE_OPENNODE_API_KEY=
# Optional hosted checkout URLs (Coinbase Commerce / BitPay invoice links)
VITE_CRYPTO_CHECKOUT_URL_ED=
VITE_CRYPTO_CHECKOUT_URL_WEIGHT=

# -----------------------------------------------------------------------------
# Server-only — set in Supabase dashboard (Edge Function secrets), never VITE_
# Required for create-checkout-session / stripe-webhook / send-notification
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe recurring Price IDs (subscription mode)
STRIPE_PRICE_ED=
STRIPE_PRICE_WEIGHT=
# Success/cancel redirect base (defaults to https://sprymd.ai)
SITE_URL=https://sprymd.ai
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# STRIPE_STATEMENT_DESCRIPTOR=SPRYMD
# COINBASE_COMMERCE_WEBHOOK_SECRET=
# EMAIL_FROM=SpryMD <notifications@sprymd.ai>
